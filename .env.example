# DeepEye 配置示例
# 复制本文件为 .env 并按需填写 API Key。

# 视觉后端提供者：openai / gemini / custom（目前仅 openai 完整实现）
VISION_PROVIDER=openai

# ---------- OpenAI 兼容后端 ----------
# OpenAI API Key（必填，使用 OpenAI 或兼容服务时）
OPENAI_API_KEY=
# 模型名称
OPENAI_MODEL=gpt-5.6-luna
# 接口地址，留空则使用官方 https://api.openai.com/v1；可改为 Azure / 代理 / 兼容服务地址
OPENAI_BASE_URL=

# ---------- Gemini 后端（预留） ----------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# ---------- 自定义 OpenAI 兼容后端（预留） ----------
CUSTOM_API_KEY=
CUSTOM_BASE_URL=
CUSTOM_MODEL=qwen-vl-max

# ---------- OCR 后端 ----------
# extract_text 工具实际使用的视觉后端：openai / gemini / custom
OCR_BACKEND=openai
